EXPO_PUBLIC_API_URL=https://your-api.example.com
EXPO_PUBLIC_SEPAY_BANK_ACCOUNT_NUMBER=
EXPO_PUBLIC_SEPAY_BANK_NAME=
EXPO_PUBLIC_SEPAY_BANK_ACCOUNT_NAME=

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_TRYON_SUPABASE_ENABLED=false
EXPO_PUBLIC_TRYON_SUPABASE_TABLE=product_tryon_assets
EXPO_PUBLIC_TRYON_SUPABASE_PRODUCT_ID_COLUMN=product_id

# Try-on (native first)
EXPO_PUBLIC_TRYON_PREFER_NATIVE=true
EXPO_PUBLIC_TRYON_NATIVE_MODULE=WdpTryOnSdk
# Optional fallback key passed to native payload.
EXPO_PUBLIC_TRYON_API_KEY=
# Optional web fallback URL when native is unavailable.
EXPO_PUBLIC_TRYON_SDK_URL=https://your-web-tryon-fallback.example.com/session
# Cache remote 3D models (glb/gltf/usdz) to local device storage for faster relaunch.
EXPO_PUBLIC_TRYON_CACHE_3D_ENABLED=true
EXPO_PUBLIC_TRYON_CACHE_3D_MAX_AGE_HOURS=168

# Demo mode: force Try-On ready for FRAME products when backend tryOn is missing/not published.
EXPO_PUBLIC_TRYON_FORCE_DEMO=false
EXPO_PUBLIC_TRYON_DEMO_EFFECT_PATH=effects/test_TeethTone
# Comma-separated resource roots (optional), for example:
# EXPO_PUBLIC_TRYON_DEMO_RESOURCE_PATHS=bnb-resources,bnb-resources/effects
EXPO_PUBLIC_TRYON_DEMO_RESOURCE_PATHS=

# Native Banuba iOS build options (used by config plugin at prebuild/build time)
BANUBA_ENABLED=true
BANUBA_ANDROID_MAVEN_URL=https://nexus.banuba.net/repository/maven-releases
# Optional for private repos. Nexus public maven usually does not require these.
BANUBA_ANDROID_MAVEN_USERNAME=
BANUBA_ANDROID_MAVEN_PASSWORD=
# Option A: all-in-one package (simple, larger apk)
BANUBA_ANDROID_SDK_DEPENDENCY=com.banuba.sdk:banuba_sdk:1.17.7
# Option B: minimal package mode for eyewear (lighter)
BANUBA_ANDROID_MINIMAL=false
BANUBA_ANDROID_SDK_VERSION=1.17.7
# Advanced: explicit dependency list (comma-separated), overrides minimal mode
# BANUBA_ANDROID_SDK_DEPENDENCIES=com.banuba.sdk:sdk_api:1.17.7,com.banuba.sdk:face_tracker:1.17.7

BANUBA_IOS_POD_NAME=BanubaSDK
BANUBA_IOS_SDK_VERSION=1.17.+
# Example: https://github.com/banuba/banuba-sdk-podspecs.git
BANUBA_IOS_PODSPEC_SOURCE=
